# ------------------------------------------------------------------
# Rumbo Nómada · variables de entorno
# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
# Las variables vacías desactivan la integración correspondiente (modo desarrollo).
# ------------------------------------------------------------------

# --- Servidor ---
NODE_ENV=development
PORT=3000
# URL pública del sitio (se usa en canonical, Open Graph, sitemap y retornos de Stripe)
APP_URL=http://localhost:3000
# Orígenes extra permitidos por CORS, separados por coma (p. ej. el dominio de Vercel)
CORS_ORIGINS=
# Saltos de proxy de confianza (1 en Render/Railway/Heroku detrás de su balanceador)
TRUST_PROXY=0

# --- Base de datos (PostgreSQL) ---
# Local con docker compose: postgresql://rumbo:rumbo@localhost:5432/rumbo_nomada?schema=public
# Neon / Supabase: añade ?sslmode=require
DATABASE_URL=postgresql://rumbo:rumbo@localhost:5432/rumbo_nomada?schema=public

# --- Administración ---
# Clave para los endpoints /api/admin/* (Authorization: Bearer <clave>). Mínimo 32 caracteres.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# --- Pagos: Stripe (modo test / sandbox) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# stripe listen --forward-to localhost:3000/api/webhooks/stripe  → imprime el whsec_...
STRIPE_WEBHOOK_SECRET=

# --- Correos transaccionales: Resend ---
# https://resend.com/api-keys  (sin clave, los correos se escriben en la consola)
RESEND_API_KEY=
MAIL_FROM=Rumbo Nómada <hola@rumbonomada.com>
MAIL_REPLY_TO=hola@rumbonomada.com

# --- Imágenes: Cloudinary (CDN + optimización f_auto/q_auto) ---
# Sin estos valores se usan las URLs originales con parámetros de Unsplash.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
